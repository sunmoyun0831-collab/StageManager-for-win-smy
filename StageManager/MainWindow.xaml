<Window
    x:Class="StageManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:StageManager"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:tb="http://www.hardcodet.net/taskbar"
    mc:Ignorable="d"
    AllowsTransparency="True"
    ShowInTaskbar="False"
    Topmost="False"
    WindowStyle="None"
    Title="MainWindow"
    Height="450"
    Width="280"
    ShowActivated="False"
    Background="Transparent"
    AllowDrop="True"
    DragEnter="Window_DragOver"
    DragOver="Window_DragOver"
    Drop="Window_Drop"
    Name="thisWindow">
    <Window.Resources>
        <BooleanToVisibilityConverter
            x:Key="BooleanToVisibility" />
        <!-- windows minimized before Stage Manager could take a picture of them show a live but flat thumbnail -->
        <Style
            x:Key="VisibleWithoutSnapshot"
            TargetType="{x:Type FrameworkElement}">
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding HasSnapshot}"
                    Value="True">
                    <Setter
                        Property="Visibility"
                        Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- cards turn towards the user while the mouse or something dragged is over their scene -->
        <Style
            x:Key="TiltedCard"
            TargetType="{x:Type local:TiltedImage}">
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type StackPanel}}}"
                    Value="True">
                    <Setter
                        Property="IsHighlighted"
                        Value="True" />
                </DataTrigger>
                <DataTrigger
                    Binding="{Binding DataContext.IsDropTarget, RelativeSource={RelativeSource AncestorType={x:Type StackPanel}}}"
                    Value="True">
                    <Setter
                        Property="IsHighlighted"
                        Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="SceneOpacity"
            TargetType="{x:Type StackPanel}">
            <Setter
                Property="Opacity"
                Value="0.8" />
            <Style.Triggers>
                <Trigger
                    Property="IsMouseOver"
                    Value="true">
                    <Setter
                        Property="Opacity"
                        Value="1" />
                </Trigger>
                <Trigger
                    Property="IsMouseOver"
                    Value="false">
                    <Setter
                        Property="Opacity"
                        Value="0.8" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- DWM draws the thumbnails on top of everything, so a drop target is highlighted around its thumbnails -->
        <Style
            x:Key="DropTargetHighlight"
            TargetType="{x:Type Border}">
            <Setter
                Property="BorderBrush"
                Value="Transparent" />
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding IsDropTarget}"
                    Value="True">
                    <Setter
                        Property="BorderBrush"
                        Value="#F0FFFFFF" />
                    <Setter
                        Property="Background"
                        Value="#50FFFFFF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="DropHintVisibility"
            TargetType="{x:Type Border}">
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding DropHint}"
                    Value="{x:Null}">
                    <Setter
                        Property="Visibility"
                        Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Border
            Style="{StaticResource DropHintVisibility}"
            VerticalAlignment="Top"
            HorizontalAlignment="Left"
            MaxWidth="240"
            Margin="12,24,12,0"
            Padding="12,8"
            CornerRadius="8"
            Background="#E6202020"
            IsHitTestVisible="False">
            <TextBlock
                Text="{Binding DropHint}"
                Foreground="White"
                TextWrapping="Wrap" />
        </Border>
        <StackPanel
            VerticalAlignment="Center">
            <ItemsControl
                Name="scenesControl"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Padding="12, 0, 0, 0"
                ItemsSource="{Binding Scenes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- the almost transparent background makes the whole scene clickable, fully transparent pixels let clicks through -->
                        <StackPanel Orientation="Vertical"
                            Visibility="{Binding Visibility}"
                            Style="{StaticResource SceneOpacity}"
                            Background="#01FFFFFF"
                            ContextMenuOpening="Scene_ContextMenuOpening">
                            <StackPanel.RenderTransform>
                                <TranslateTransform />
                            </StackPanel.RenderTransform>
                            <StackPanel.Triggers>
                                <!-- scenes slide into the sidebar -->
                                <EventTrigger
                                    RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                From="-80"
                                                To="0"
                                                Duration="0:0:0.35">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase
                                                        EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="Opacity"
                                                From="0"
                                                To="0.8"
                                                Duration="0:0:0.35"
                                                FillBehavior="Stop" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </StackPanel.Triggers>
                            <StackPanel.ContextMenu>
                                <!-- filled when opening -->
                                <ContextMenu
                                    Opened="SceneContextMenu_Opened"
                                    Closed="ContextMenu_Closed" />
                            </StackPanel.ContextMenu>
                            <i:Interaction.Triggers>
                                <i:EventTrigger
                                    EventName="MouseLeftButtonUp">
                                    <i:InvokeCommandAction
                                        Command="{Binding SwitchSceneCommand, Mode=OneTime, Source={x:Reference thisWindow}}"
                                        CommandParameter="{Binding .}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                            <!-- Windows -->
                            <Border
                                Style="{StaticResource DropTargetHighlight}"
                                BorderThickness="3"
                                CornerRadius="10"
                                Padding="6">
                                <ItemsControl
                                    ItemsSource="{Binding Windows}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Grid
                                                Margin="0,0,0,0"></Grid>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <!-- the windows of a scene are stacked, the front window on top -->
                                    <ItemsControl.ItemContainerStyle>
                                        <Style
                                            TargetType="{x:Type ContentPresenter}">
                                            <Setter
                                                Property="Panel.ZIndex"
                                                Value="{Binding ZIndex}" />
                                            <Setter
                                                Property="Visibility"
                                                Value="{Binding StackVisibility}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid
                                                Width="200"
                                                Height="130">
                                                <!-- flat thumbnails can't go back in depth, they are stacked by shrinking and moving them -->
                                                <local:DwmThumbnail
                                                    PreviewHandle="{Binding Handle}"
                                                    Style="{StaticResource VisibleWithoutSnapshot}"
                                                    Width="170"
                                                    Height="105"
                                                    RenderTransformOrigin="0.5,0.5">
                                                    <local:DwmThumbnail.RenderTransform>
                                                        <TransformGroup>
                                                            <ScaleTransform
                                                                ScaleX="{Binding StackScale}"
                                                                ScaleY="{Binding StackScale}" />
                                                            <TranslateTransform
                                                                X="{Binding StackOffsetX}"
                                                                Y="{Binding StackOffsetY}" />
                                                        </TransformGroup>
                                                    </local:DwmThumbnail.RenderTransform>
                                                </local:DwmThumbnail>
                                                <local:TiltedImage
                                                    Source="{Binding Snapshot}"
                                                    StackIndex="{Binding StackIndex}"
                                                    Style="{StaticResource TiltedCard}"
                                                    Visibility="{Binding HasSnapshot, Converter={StaticResource BooleanToVisibility}}">
                                                    <local:TiltedImage.Effect>
                                                        <DropShadowEffect
                                                            BlurRadius="18"
                                                            ShadowDepth="4"
                                                            Opacity="0.45" />
                                                    </local:TiltedImage.Effect>
                                                </local:TiltedImage>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <!-- Icons, overlapping the bottom of the cards like on macOS -->
                            <ItemsControl
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Margin="10,-26,0,18"
                                ItemsSource="{Binding Windows}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel
                                            Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border>
                                            <Border.Effect>
                                                <DropShadowEffect
                                                    BlurRadius="20" />
                                            </Border.Effect>
                                            <Image
                                                Margin="0, 0, 0, 0"
                                                Height="30"
                                                Source="{Binding Icon}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <tb:TaskbarIcon
                x:Name="trayIcon"
                Visibility="Visible"
                ToolTipText="Stage Manager"
                IconSource="StageManager.ico"
                MenuActivation="LeftOrRightClick">
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu
                        Opened="ContextMenu_Opened"
                        Closed="ContextMenu_Closed">
                        <MenuItem
                            Header="Stage Manager"
                            Style="{StaticResource Menu.Title}" />
                        <MenuItem
                            x:Name="pinnedAppsMenu"
                            Header="Pinned apps">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xE718;" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem
                            x:Name="animationsMenuItem"
                            Header="Window animations"
                            IsCheckable="True"
                            StaysOpenOnClick="True"
                            Click="MenuItem_Animations_Click">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xE945;" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Header="Start with Windows"
                            IsCheckable="True"
                            StaysOpenOnClick="True"
                            IsChecked="{Binding StartsWithWindows}">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xE7F4;" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            x:Name="debugLogMenuItem"
                            Header="Debug log for bug reports"
                            IsCheckable="True"
                            StaysOpenOnClick="True"
                            Click="MenuItem_DebugLog_Click">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xEBE8;" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem
                            Header="Project page"
                            Click="MenuItem_ProjectPage_Click">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xE774;" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Header="Quit Stage Manager"
                            Click="MenuItem_Quit_Click">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xE7E8;" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>
        </StackPanel>
    </Grid>
</Window>
